+export async function ensureMarsPayfull02SyntheticPensionArrangement(input: {
+  readonly employeeId: string
+  readonly employmentId: string
+  readonly requestKey: string
+}): Promise<{
+  readonly arrangementId: string
+  readonly versionId: string
+  readonly versionNumber: number
+  readonly arrangementReused: boolean
+  readonly sourceClassification: string
+}> {
+  if (!UUID_PATTERN.test(input.employeeId) || !UUID_PATTERN.test(input.employmentId)
+    || !UUID_PATTERN.test(input.requestKey)) {
+    throw new EmploymentPensionArrangementError('PENSION_SYNTHETIC_ARRANGEMENT_INPUT_INVALID', 400)
+  }
+  const { employment, context } = await scopedEmployment(input.employeeId, input.employmentId, 'pension:manage')
+  if (!isPensionManager(context)) throw new EmploymentPensionArrangementError('PENSION_SYNTHETIC_ARRANGEMENT_FORBIDDEN', 403)
+  if (!isSyntheticPensionFixtureRuntimeEnabled()) {
+    throw new EmploymentPensionArrangementError('PENSION_TEST_FIXTURE_DISABLED', 403)
+  }
+
+  const supabase = await createClient()
+  const authResult = await supabase.auth.getUser()
+  if (authResult.error || !isSyntheticPensionFixtureEnabled(process.env, authResult.data.user?.app_metadata)) {
+    throw new EmploymentPensionArrangementError('PENSION_TEST_FIXTURE_DISABLED', 403)
+  }
+  const { data, error } = await supabase.rpc('create_mars_payfull02_synthetic_pension_arrangement', {
+    p_input: {
+      employee_id: employment.employee_id,
+      employment_id: employment.id,
+      request_key: input.requestKey,
+      scenario: MARS_PAYFULL02_SYNTHETIC_SCENARIO,
+    } satisfies Json,
+  })
+  if (error || !data || typeof data !== 'object' || Array.isArray(data)) {
+    const code = error?.message.match(/PENSION_[A-Z_]+/)?.[0] ?? 'PENSION_SYNTHETIC_ARRANGEMENT_WRITE_FAILED'
+    const status = code.endsWith('_FORBIDDEN') || code.endsWith('_DISABLED') ? 403
+      : code.endsWith('_NOT_FOUND') ? 404
+        : code.endsWith('_CONFLICT') ? 409 : 400
+    throw new EmploymentPensionArrangementError(code, status)
+  }
+  const result = data as Record<string, unknown>
+  const arrangementId = result.arrangement_id
+  const versionId = result.version_id
+  const versionNumber = Number(result.version_number)
+  const sourceClassification = result.source_classification
+  if (typeof arrangementId !== 'string' || typeof versionId !== 'string'
+    || !Number.isInteger(versionNumber) || typeof sourceClassification !== 'string') {
+    throw new EmploymentPensionArrangementError('PENSION_SYNTHETIC_ARRANGEMENT_WRITE_READBACK_INVALID', 500)
+  }
+  return {
+    arrangementId,
+    versionId,
+    versionNumber,
+    arrangementReused: result.arrangement_reused === true,
+    sourceClassification,
+  }
+}
