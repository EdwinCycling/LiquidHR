diff --git a/apps/hr-suite/lib/errors/database-read-error.test.ts b/apps/hr-suite/lib/errors/database-read-error.test.ts
new file mode 100644
index 00000000..62d9d88c
--- /dev/null
+++ b/apps/hr-suite/lib/errors/database-read-error.test.ts
@@ -0,0 +1,38 @@
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { DatabaseReadError, logDatabaseReadFailure, throwDatabaseReadError } from './database-read-error'
+
+describe('database read errors', () => {
+  afterEach(() => vi.restoreAllMocks())
+
+  it('logs only the operation and validated SQLSTATE, then throws a generic error', () => {
+    const log = vi.spyOn(console, 'error').mockImplementation(() => undefined)
+    const databaseError = {
+      code: '57014',
+      message: 'private query text',
+      details: 'private record details',
+      hint: 'private server hint',
+    }
+
+    expect(() => throwDatabaseReadError(databaseError, 'auth.context.groupAccess'))
+      .toThrow(DatabaseReadError)
+    expect(log).toHaveBeenCalledOnce()
+    expect(log).toHaveBeenCalledWith('[LiquidHR] Database read failed', {
+      operation: 'auth.context.groupAccess',
+      sqlstate: '57014',
+    })
+    expect(JSON.stringify(log.mock.calls)).not.toContain('private')
+  })
+
+  it('omits malformed SQLSTATEs and unsafe operation labels from server logs', () => {
+    const log = vi.spyOn(console, 'error').mockImplementation(() => undefined)
+
+    logDatabaseReadFailure({ code: 'secret-value', message: 'private query text' }, 'operation with user data')
+
+    expect(log).toHaveBeenCalledWith('[LiquidHR] Database read failed', {
+      operation: 'database.read',
+      sqlstate: 'UNKNOWN',
+    })
+    expect(JSON.stringify(log.mock.calls)).not.toContain('private')
+    expect(JSON.stringify(log.mock.calls)).not.toContain('secret-value')
+  })
+})
diff --git a/apps/hr-suite/lib/errors/database-read-error.ts b/apps/hr-suite/lib/errors/database-read-error.ts
new file mode 100644
index 00000000..04ead426
--- /dev/null
+++ b/apps/hr-suite/lib/errors/database-read-error.ts
@@ -0,0 +1,30 @@
+const SAFE_SQLSTATE = /^[A-Z0-9]{5}$/
+const SAFE_OPERATION = /^[A-Za-z0-9_.-]{1,80}$/
+
+export class DatabaseReadError extends Error {
+  constructor() {
+    super('DATABASE_READ_FAILED')
+    this.name = 'DatabaseReadError'
+  }
+}
+
+export function logDatabaseReadFailure(error: unknown, operation: string): void {
+  let sqlstate = 'UNKNOWN'
+  try {
+    const candidate = error && typeof error === 'object'
+      ? (error as { code?: unknown }).code
+      : undefined
+    if (typeof candidate === 'string' && SAFE_SQLSTATE.test(candidate)) sqlstate = candidate
+  } catch {
+    // Error objects from clients are expected to be plain data, but logging
+    // must remain safe even if a custom object has throwing property access.
+  }
+
+  const safeOperation = SAFE_OPERATION.test(operation) ? operation : 'database.read'
+  console.error('[LiquidHR] Database read failed', { operation: safeOperation, sqlstate })
+}
+
+export function throwDatabaseReadError(error: unknown, operation: string): never {
+  logDatabaseReadFailure(error, operation)
+  throw new DatabaseReadError()
+}
