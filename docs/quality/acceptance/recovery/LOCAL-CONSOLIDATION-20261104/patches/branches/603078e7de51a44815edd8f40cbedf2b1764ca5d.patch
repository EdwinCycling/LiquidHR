+import { describe, expect, it } from 'vitest'
+import { resolveEmploymentSalaryBasis } from './salary-basis-resolution'
+
+const revisions = [
+  { salaryStructureId: 'cao', effectiveFrom: '2026-09-01', revisionNumber: 4, status: 'PUBLISHED', salaryBasis: 'CAO_SCALE' },
+  { salaryStructureId: 'cao', effectiveFrom: '2026-11-01', revisionNumber: 5, status: 'DRAFT', salaryBasis: 'CUSTOM_SCALE' },
+  { salaryStructureId: 'custom', effectiveFrom: '2025-01-01', revisionNumber: 1, status: 'PUBLISHED', salaryBasis: 'CUSTOM_SCALE' },
+]
+
+describe('resolveEmploymentSalaryBasis', () => {
+  it('uses the published CAO basis effective on the salary date', () => {
+    expect(resolveEmploymentSalaryBasis({ route: 'SCALE_WITH_STEPS', salaryStructureId: 'cao', effectiveOn: '2026-11-01', revisions }))
+      .toBe('CAO_SCALE')
+  })
+
+  it('keeps a generic scale as a custom scale', () => {
+    expect(resolveEmploymentSalaryBasis({ route: 'SCALE_WITH_STEPS', salaryStructureId: 'custom', effectiveOn: '2026-11-01', revisions }))
+      .toBe('CUSTOM_SCALE')
+  })
+
+  it('does not apply a future or unpublished revision early', () => {
+    expect(resolveEmploymentSalaryBasis({ route: 'SCALE_WITH_STEPS', salaryStructureId: 'cao', effectiveOn: '2026-08-31', revisions }))
+      .toBe('CUSTOM_SCALE')
+  })
+
+  it('preserves a saved CAO basis if revision options are unavailable', () => {
+    expect(resolveEmploymentSalaryBasis({ route: 'SCALE_WITH_STEPS', salaryStructureId: 'cao', effectiveOn: '2026-11-01', revisions: [], existingBasis: 'CAO_SCALE' }))
+      .toBe('CAO_SCALE')
+  })
+
+  it('maps non-scale routes directly to their salary basis', () => {
+    expect(resolveEmploymentSalaryBasis({ route: 'MINIMUM_WAGE', salaryStructureId: null, effectiveOn: '2026-11-01', revisions }))
+      .toBe('MINIMUM_WAGE')
+  })
+})
diff --git a/apps/hr-suite/lib/employment/salary-basis-resolution.ts b/apps/hr-suite/lib/employment/salary-basis-resolution.ts
new file mode 100644
index 00000000..9ed908c9
--- /dev/null
+++ b/apps/hr-suite/lib/employment/salary-basis-resolution.ts
@@ -0,0 +1,35 @@
+export type EmploymentSalaryBasis = 'MANUAL' | 'MINIMUM_WAGE' | 'CUSTOM_SCALE' | 'SALARY_BAND' | 'CAO_SCALE'
+export type EmploymentSalaryRoute = 'MANUAL' | 'MINIMUM_WAGE' | 'SCALE_WITH_STEPS' | 'SALARY_BAND'
+
+export type PublishedSalaryBasisRevision = {
+  readonly salaryStructureId: string
+  readonly effectiveFrom: string
+  readonly revisionNumber: number
+  readonly status: string
+  readonly salaryBasis: string
+}
+
+export function resolveEmploymentSalaryBasis(input: {
+  readonly route: EmploymentSalaryRoute
+  readonly salaryStructureId: string | null
+  readonly effectiveOn: string
+  readonly revisions: readonly PublishedSalaryBasisRevision[]
+  readonly existingBasis?: EmploymentSalaryBasis
+}): EmploymentSalaryBasis {
+  if (input.route === 'MANUAL') return 'MANUAL'
+  if (input.route === 'MINIMUM_WAGE') return 'MINIMUM_WAGE'
+  if (input.route === 'SALARY_BAND') return 'SALARY_BAND'
+
+  const applicableRevision = input.salaryStructureId
+    ? input.revisions
+      .filter((revision) => revision.status === 'PUBLISHED'
+        && revision.salaryStructureId === input.salaryStructureId
+        && revision.effectiveFrom <= input.effectiveOn)
+      .sort((left, right) => right.effectiveFrom.localeCompare(left.effectiveFrom)
+        || right.revisionNumber - left.revisionNumber)[0]
+    : undefined
+
+  if (applicableRevision?.salaryBasis === 'CAO_SCALE') return 'CAO_SCALE'
+  if (applicableRevision) return 'CUSTOM_SCALE'
+  return input.existingBasis === 'CAO_SCALE' ? 'CAO_SCALE' : 'CUSTOM_SCALE'
+}
